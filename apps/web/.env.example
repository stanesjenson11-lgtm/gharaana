# Copy to .env.local. `pnpm db:start` runs the dev database on port 5440.
DATABASE_URL=postgres://postgres@localhost:5440/directnest

# Any long random string: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3100

# In production the secrets (DATABASE_URL, BETTER_AUTH_SECRET, GOOGLE_CLIENT_SECRET, APPLE_CLIENT_SECRET, MSG91_AUTH_KEY,
# WHATSAPP_TOKEN, TURNSTILE_SECRET_KEY) live in HashiCorp Vault, not in a file on the server. At start-up the app reads one
# KV v2 secret and keeps the values in memory only, and it refuses to start in production without a Vault:
#   vault kv put secret/directnest/web DATABASE_URL=... BETTER_AUTH_SECRET=... TURNSTILE_SECRET_KEY=... MSG91_AUTH_KEY=...
# The process needs one way in, and that must not be a file either: a short-lived token from Vault Agent, or an AppRole whose
# secret id is wrapped and short-lived. Both are removed from the environment once used.
# VAULT_ADDR=https://vault.example.com:8200
# VAULT_TOKEN=             # or VAULT_ROLE_ID= and VAULT_SECRET_ID=
# VAULT_NAMESPACE=         # Vault Enterprise and HCP only
# VAULT_MOUNT=secret       # the KV v2 mount; this is the default
# VAULT_SECRET_PATH=directnest/web
# ALLOW_ENV_SECRETS=1      # run production on environment secrets anyway. Not recommended.

# Optional until the client's accounts exist. Without MSG91, OTP codes are printed to the dev server log.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# Sign in with Apple. APPLE_CLIENT_ID is the Services ID. The secret is a token that lasts six months:
#   pnpm apple-secret <TEAM_ID> <KEY_ID> <SERVICES_ID> <path to AuthKey_XXXX.p8>
# Apple only accepts https callbacks, so it can't be tried on localhost.
# APPLE_CLIENT_ID=
# APPLE_CLIENT_SECRET=
# APPLE_APP_BUNDLE_ID=
# The client's support line, shown on the help page and in the footer, e.g. +918012345678.
# SUPPORT_PHONE=

# WhatsApp Cloud API, for alerts. The template is Meta-approved with one body variable ({{1}}) for the alert text.
# WHATSAPP_TOKEN=
# WHATSAPP_PHONE_ID=
# WHATSAPP_TEMPLATE=
# WHATSAPP_TEMPLATE_LANG=en

# MSG91: the auth key from the MSG91 dashboard, and the ID of the DLT-approved OTP template (its text must contain ##OTP##).
# MSG91_AUTH_KEY=
# MSG91_OTP_TEMPLATE_ID=
# Test deploys only (e.g. Vercel) while MSG91 isn't set up: print sign-in codes to the server log instead of failing.
# OTP_IN_LOGS=1

# Cloudflare Turnstile bot challenge:
# Testing dummy keys:
# Always passes: sitekey 1x00000000000000000000AA, secret 1x0000000000000000000000000000000AA
# Always fails: sitekey 2x00000000000000000000AB, secret 2x0000000000000000000000000000000AA
# In local development, if left unset, verification passes automatically.
# NEXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA
# TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA

# Test servers only: no text-message codes at all (Google sign-in counts as a confirmed number; staff skip the morning code).
# SKIP_PHONE_OTP=1
